{% extends 'base.html.twig' %}

{% block title %}Administration — Le Guide Normand{% endblock %}

{% block body %}

<div style="background: linear-gradient(135deg, #1a1a2e, #16213e); color: white; padding: 2rem 0;">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h1 style="font-family:'Playfair Display',serif;" class="mb-1">
                    <i class="fa-solid fa-shield-halved me-2"></i>Administration
                </h1>
                <p class="opacity-75 mb-0">Tableau de bord — Le Guide Normand</p>
            </div>
            <div class="d-flex gap-2">
                <a href="{{ path('app_admin_lieux') }}" class="btn btn-outline-light btn-sm">
                    <i class="fa-solid fa-map-location-dot me-1"></i>Gérer les lieux
                </a>
                <a href="{{ path('app_admin_users') }}" class="btn btn-outline-light btn-sm">
                    <i class="fa-solid fa-users me-1"></i>Gérer les users
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container py-4">

    {# Stats #}
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-2">
            <div class="card border-0 shadow-sm text-center p-3">
                <div class="fs-2 fw-bold" style="color:#1a1a2e;">{{ stats.lieux }}</div>
                <div class="small text-muted">Lieux total</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card border-0 shadow-sm text-center p-3 {{ stats.lieuxEnAttente > 0 ? 'border-warning' : '' }}">
                <div class="fs-2 fw-bold text-warning">{{ stats.lieuxEnAttente }}</div>
                <div class="small text-muted">En attente</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card border-0 shadow-sm text-center p-3">
                <div class="fs-2 fw-bold text-success">{{ stats.terrains }}</div>
                <div class="small text-muted">Terrains</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card border-0 shadow-sm text-center p-3">
                <div class="fs-2 fw-bold" style="color:#1a237e;">{{ stats.evenements }}</div>
                <div class="small text-muted">Événements</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card border-0 shadow-sm text-center p-3">
                <div class="fs-2 fw-bold" style="color:var(--normand-red);">{{ stats.users }}</div>
                <div class="small text-muted">Utilisateurs</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card border-0 shadow-sm text-center p-3">
                <div class="fs-2 fw-bold" style="color:var(--normand-gold);">{{ stats.avis }}</div>
                <div class="small text-muted">Avis</div>
            </div>
        </div>
    </div>

    <div class="row g-4">

        {# Lieux en attente #}
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between mb-3">
                        <h5 class="fw-bold mb-0">
                            <i class="fa-solid fa-clock me-2 text-warning"></i>Lieux en attente
                        </h5>
                        <a href="{{ path('app_admin_lieux') }}" class="btn btn-sm btn-outline-secondary">Voir tout</a>
                    </div>
                    {% if derniers_lieux is empty %}
                        <p class="text-muted fst-italic">✅ Aucun lieu en attente de validation.</p>
                    {% else %}
                        {% for lieu in derniers_lieux %}
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <div>
                                <div class="fw-bold small">{{ lieu.titre }}</div>
                                <div class="text-muted" style="font-size:0.75rem;">
                                    {{ lieu.user.email }} · {{ lieu.createdAt|date('d/m/Y') }}
                                </div>
                            </div>
                            <a href="{{ path('app_admin_lieu_valider', {id: lieu.id}) }}"
                               class="btn btn-success btn-sm">
                                <i class="fa-solid fa-check"></i> Valider
                            </a>
                        </div>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </div>

        {# Derniers utilisateurs #}
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between mb-3">
                        <h5 class="fw-bold mb-0">
                            <i class="fa-solid fa-users me-2" style="color:var(--normand-red);"></i>Derniers inscrits
                        </h5>
                        <a href="{{ path('app_admin_users') }}" class="btn btn-sm btn-outline-secondary">Voir tout</a>
                    </div>
                    {% for user in derniers_users %}
                    <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                             style="width:36px;height:36px;background:var(--normand-gold);color:var(--normand-red);flex-shrink:0;">
                            {{ user.email|slice(0,1)|upper }}
                        </div>
                        <div class="flex-grow-1">
                            <div class="small fw-bold">{{ user.prenom }} {{ user.nom }}</div>
                            <div class="text-muted" style="font-size:0.75rem;">{{ user.email }}</div>
                        </div>
                        <div>
                            {% for role in user.roles %}
                                {% if role == 'ROLE_ADMIN' %}
                                    <span class="badge bg-danger">Admin</span>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        {# Derniers avis #}
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">
                        <i class="fa-solid fa-star me-2" style="color:var(--normand-gold);"></i>Derniers avis
                    </h5>
                    {% if derniers_avis is empty %}
                        <p class="text-muted fst-italic">Aucun avis pour le moment.</p>
                    {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Utilisateur</th>
                                    <th>Lieu / Terrain</th>
                                    <th>Note</th>
                                    <th>Commentaire</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for avis in derniers_avis %}
                                <tr>
                                    <td><small>{{ avis.user.email }}</small></td>
                                    <td><small>{{ avis.lieu ? avis.lieu.titre : (avis.terrain ? avis.terrain.titre : '—') }}</small></td>
                                    <td>
                                        <span class="stars">
                                            {% for i in 1..avis.note %}<i class="fa-solid fa-star fa-xs"></i>{% endfor %}
                                        </span>
                                    </td>
                                    <td><small class="text-muted">{{ avis.commentaire|slice(0,60) }}...</small></td>
                                    <td><small>{{ avis.createdAt|date('d/m/Y') }}</small></td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>

    </div>
</div>

{% endblock %}