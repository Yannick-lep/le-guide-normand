{% extends 'base.html.twig' %}

{% block title %}Mes favoris — Le Guide Normand{% endblock %}

{% block body %}

<div style="background: linear-gradient(135deg, var(--normand-red), #A52A2A); color: white; padding: 2.5rem 0; position: relative; overflow: hidden;">
    <div class="container">
        <h1 style="font-family:'Playfair Display',serif;">
            <i class="fa-solid fa-heart me-2"></i>Mes favoris
        </h1>
        <p class="opacity-75 mb-0">{{ lieux|length }} lieu{{ lieux|length > 1 ? 'x' : '' }} sauvegardé{{ lieux|length > 1 ? 's' : '' }}</p>
    </div>
</div>

<div class="container py-4">
    {% if lieux is empty %}
    <div class="text-center py-5 text-muted">
        <i class="fa-solid fa-heart fa-4x mb-3 opacity-25"></i>
        <h5>Aucun favori pour le moment</h5>
        <p>Cliquez sur le ❤️ sur les pages de lieux pour les sauvegarder ici.</p>
        <a href="{{ path('app_lieu_index') }}" class="btn btn-normand">
            Explorer les bons plans
        </a>
    </div>
    {% else %}
    <div class="row g-4">
        {% for lieu in lieux %}
        <div class="col-md-6 col-lg-4">
            <div class="card card-normand h-100">
                {% if lieu.imageName %}
                <img src="/images/lieux/{{ lieu.imageName }}"
                     alt="{{ lieu.titre }}" class="card-img-top"
                     style="height: 160px; object-fit: cover;">
                {% else %}
                <div class="card-img-top d-flex align-items-center justify-content-center"
                     style="height: 160px; background: linear-gradient(135deg, #8B1A1A, #2D5A27);">
                    <i class="fa-solid {{ lieu.categorie ? lieu.categorie.icone : 'fa-map-pin' }} fa-3x text-white opacity-50"></i>
                </div>
                {% endif %}
                <div class="card-body d-flex flex-column">
                    {% if lieu.categorie %}
                    <span class="badge-categorie mb-2 d-inline-block">{{ lieu.categorie.nom }}</span>
                    {% endif %}
                    <h6 class="fw-bold">{{ lieu.titre }}</h6>
                    <p class="text-muted small flex-grow-1">{{ lieu.description|slice(0,80) }}...</p>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <small class="text-muted">
                            <i class="fa-solid fa-map-pin me-1"></i>{{ lieu.adresse ?? 'Normandie' }}
                        </small>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-danger favori-btn"
                                    data-lieu-id="{{ lieu.id }}"
                                    title="Retirer des favoris">
                                <i class="fa-solid fa-heart"></i>
                            </button>
                            <a href="{{ path('app_lieu_show', {slug: lieu.slug}) }}"
                               class="btn btn-normand btn-sm">Voir</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>

{% endblock %}

{% block javascripts %}
<script>
document.querySelectorAll('.favori-btn').forEach(btn => {
    btn.addEventListener('click', async function() {
        const lieuId = this.dataset.lieuId;
        const response = await fetch('/favoris/toggle/' + lieuId, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        const data = await response.json();
        if (!data.estFavori) {
            this.closest('.col-md-6').remove();
        }
    });
});
</script>
{% endblock %}

