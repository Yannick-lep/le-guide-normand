{% extends 'base.html.twig' %}

{% block title %}Recherche "{{ q }}" — Le Guide Normand{% endblock %}

{% block body %}

<div style="background: linear-gradient(135deg, #1a1a2e, #16213e); color: white; padding: 2.5rem 0;">
    <div class="container">
        <h1 style="font-family:'Playfair Display',serif;" class="mb-3">
            <i class="fa-solid fa-magnifying-glass me-2"></i>Recherche
        </h1>
        <form method="get" action="{{ path('app_recherche') }}">
            <div class="input-group input-group-lg" style="max-width: 600px;">
                <input type="text" name="q" class="form-control" value="{{ q }}"
                       placeholder="Rechercher un lieu, terrain, événement...">
                <button class="btn btn-light fw-bold" type="submit">
                    <i class="fa-solid fa-search me-1"></i>Rechercher
                </button>
            </div>
        </form>
        {% if q %}
        <p class="mt-3 opacity-75 mb-0">
            <strong>{{ total }}</strong> résultat{{ total > 1 ? 's' : '' }} pour "{{ q }}"
        </p>
        {% endif %}
    </div>
</div>

<div class="container py-4">

    {% if q and total == 0 %}
    <div class="text-center py-5 text-muted">
        <i class="fa-solid fa-search fa-4x mb-3 opacity-25"></i>
        <h5>Aucun résultat pour "{{ q }}"</h5>
        <p>Essayez avec d'autres mots-clés.</p>
    </div>
    {% endif %}

    {# ── Bons Plans ── #}
    {% if lieux|length > 0 %}
    <div class="mb-5">
        <div class="d-flex align-items-center gap-2 mb-3">
            <h4 class="section-title mb-0">
                <i class="fa-solid fa-map-location-dot me-2"></i>Bons Plans
            </h4>
            <span class="badge" style="background:var(--normand-red);">{{ lieux|length }}</span>
        </div>
        <div class="section-divider"></div>
        <div class="row g-3">
            {% for lieu in lieux %}
            <div class="col-md-6 col-lg-4">
                <div class="card card-normand h-100">
                    <div class="card-body">
                        {% if lieu.categorie %}
                        <span class="badge-categorie mb-2 d-inline-block">{{ lieu.categorie.nom }}</span>
                        {% endif %}
                        <h6 class="fw-bold">{{ lieu.titre }}</h6>
                        <p class="text-muted small mb-2">{{ lieu.description|slice(0,80) }}...</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                <i class="fa-solid fa-map-pin me-1"></i>{{ lieu.adresse ?? 'Normandie' }}
                            </small>
                            <a href="{{ path('app_lieu_show', {slug: lieu.slug}) }}"
                               class="btn btn-normand btn-sm">Voir</a>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# ── Terrains ── #}
    {% if terrains|length > 0 %}
    <div class="mb-5">
        <div class="d-flex align-items-center gap-2 mb-3">
            <h4 class="section-title mb-0">
                <i class="fa-solid fa-tent me-2"></i>Terrains
            </h4>
            <span class="badge bg-success">{{ terrains|length }}</span>
        </div>
        <div class="section-divider"></div>
        <div class="row g-3">
            {% for terrain in terrains %}
            <div class="col-md-6 col-lg-4">
                <div class="card card-normand h-100">
                    <div class="card-body">
                        <h6 class="fw-bold">{{ terrain.titre }}</h6>
                        <p class="text-muted small mb-2">{{ terrain.description|slice(0,80) }}...</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold" style="color:var(--normand-green);">
                                {% if terrain.prixNuit %}{{ terrain.prixNuit }} €/nuit
                                {% else %}<span class="text-success">Gratuit</span>{% endif %}
                            </span>
                            <a href="{{ path('app_terrain_show', {id: terrain.id}) }}"
                               class="btn btn-sm" style="background:var(--normand-green);color:white;">Voir</a>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# ── Événements ── #}
    {% if evenements|length > 0 %}
    <div class="mb-5">
        <div class="d-flex align-items-center gap-2 mb-3">
            <h4 class="section-title mb-0">
                <i class="fa-solid fa-calendar-days me-2"></i>Événements
            </h4>
            <span class="badge" style="background:#1a237e;">{{ evenements|length }}</span>
        </div>
        <div class="section-divider"></div>
        <div class="row g-3">
            {% for evenement in evenements %}
            <div class="col-md-6 col-lg-4">
                <div class="card card-normand h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="text-center rounded-2 p-2"
                                 style="background:#1a237e;color:white;min-width:45px;">
                                <div class="fw-bold lh-1">{{ evenement.dateDebut|date('d') }}</div>
                                <div class="small text-uppercase">{{ evenement.dateDebut|date('M') }}</div>
                            </div>
                            <h6 class="fw-bold mb-0">{{ evenement.titre }}</h6>
                        </div>
                        <p class="text-muted small mb-2">{{ evenement.description|slice(0,80) }}...</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge {{ evenement.estGratuit ? 'bg-success' : 'bg-secondary' }}">
                                {{ evenement.estGratuit ? 'Gratuit' : evenement.prix ~ ' €' }}
                            </span>
                            <a href="{{ path('app_evenement_show', {id: evenement.id}) }}"
                               class="btn btn-sm" style="background:#1a237e;color:white;">Voir</a>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

</div>

{% endblock %}