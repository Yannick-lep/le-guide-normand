{% extends 'base.html.twig' %}

{% block title %}Événements — Le Guide Normand{% endblock %}

{% block body %}

<div style="background: linear-gradient(135deg, #1a237e, #283593); color: white; padding: 3rem 0; position: relative; overflow: hidden;">
    <div class="container">
        <h1 style="font-family: 'Playfair Display', serif;" class="mb-2">
            <i class="fa-solid fa-calendar-days me-2"></i>Événements à venir
        </h1>
        <p class="opacity-75 mb-0">Randonnées, festivals, visites guidées... ne ratez rien en Normandie</p>
    </div>
</div>

<div class="container py-4">
    <div class="row g-4">

        {# ── SIDEBAR FILTRES ── #}
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold mb-3"><i class="fa-solid fa-filter me-2"></i>Filtres</h6>
                    <form method="get">
                        <div class="mb-3">
                            <input type="text" name="q" class="form-control form-control-sm"
                                   placeholder="Rechercher..." value="{{ recherche ?? '' }}">
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" name="gratuit"
                                   id="gratuit" value="1" {{ filtreGratuit ? 'checked' : '' }}>
                            <label class="form-check-label small" for="gratuit">
                                <i class="fa-solid fa-euro-sign me-1 text-success"></i>Événements gratuits
                            </label>
                        </div>
                        <button type="submit" class="btn btn-sm w-100 mb-2"
                                style="background: #1a237e; color: white;">
                            <i class="fa-solid fa-filter me-1"></i>Filtrer
                        </button>
                        <a href="{{ path('app_evenement_index') }}"
                           class="btn btn-outline-secondary btn-sm w-100">
                            Réinitialiser
                        </a>
                    </form>
                </div>
            </div>
        </div>

        {# ── LISTE DES ÉVÉNEMENTS ── #}
        <div class="col-lg-9">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted">
                    <strong>{{ evenements|length }}</strong> événement{{ evenements|length > 1 ? 's' : '' }} à venir
                </span>
                {% if app.user %}
                <a href="{{ path('app_evenement_new') }}" class="btn btn-sm" style="background: #1a237e; color: white;">
                    <i class="fa-solid fa-plus me-1"></i>Proposer un événement
                </a>
                {% endif %}
            </div>

            {% if evenements is empty %}
            <div class="text-center py-5 text-muted">
                <i class="fa-solid fa-calendar-xmark fa-4x mb-3 opacity-25"></i>
                <h5>Aucun événement à venir</h5>
                <p>Revenez bientôt ou proposez le vôtre !</p>
            </div>
            {% else %}
            <div class="d-flex flex-column gap-3">
                {% for evenement in evenements %}
                <div class="card card-normand">
                    <div class="card-body">
                        <div class="row align-items-center g-3">

                            {# Date #}
                            <div class="col-auto">
                                <div class="text-center rounded-3 p-3"
                                     style="background: #1a237e; color: white; min-width: 65px;">
                                    <div class="fw-bold fs-4 lh-1">{{ evenement.dateDebut|date('d') }}</div>
                                    <div class="small text-uppercase opacity-75">{{ evenement.dateDebut|date('M', null, 'fr') }}</div>
                                    <div class="small opacity-75">{{ evenement.dateDebut|date('Y') }}</div>
                                </div>
                            </div>

                            {# Infos #}
                            <div class="col">
                                <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                    <h5 class="fw-bold mb-0">{{ evenement.titre }}</h5>
                                    <span class="badge {{ evenement.estGratuit ? 'bg-success' : 'bg-secondary' }}">
                                        {{ evenement.estGratuit ? 'Gratuit' : evenement.prix ~ ' €' }}
                                    </span>
                                </div>
                                <p class="text-muted small mb-2">
                                    <i class="fa-solid fa-map-pin me-1"></i>{{ evenement.adresse ?? 'Normandie' }}
                                    <span class="mx-2">·</span>
                                    <i class="fa-solid fa-clock me-1"></i>{{ evenement.dateDebut|date('H:i') }}
                                    {% if evenement.dateFin %} → {{ evenement.dateFin|date('H:i') }}{% endif %}
                                    {% if evenement.placesMax %}
                                    <span class="mx-2">·</span>
                                    <i class="fa-solid fa-users me-1"></i>{{ evenement.placesMax }} places max
                                    {% endif %}
                                </p>
                                <p class="small mb-0">{{ evenement.description|slice(0, 120) }}...</p>
                            </div>

                            {# Bouton #}
                            <div class="col-auto">
                                <a href="{{ path('app_evenement_show', {id: evenement.id}) }}"
                                   class="btn btn-sm" style="background: #1a237e; color: white;">
                                    Voir <i class="fa-solid fa-arrow-right ms-1"></i>
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% endif %}

        </div>
    </div>
</div>

{% endblock %}
