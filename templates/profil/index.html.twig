{% extends 'base.html.twig' %}

{% block title %}Mon profil — Le Guide Normand{% endblock %}

{% block body %}

<div style="background: linear-gradient(135deg, var(--normand-red), #A52A2A); color: white; padding: 3rem 0; position: relative; overflow: hidden;">
    <div class="container">
        <div class="d-flex align-items-center gap-4 flex-wrap">
            {# Avatar #}
            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                 style="width:80px;height:80px;background:var(--normand-gold);color:var(--normand-red);font-size:2rem;flex-shrink:0;">
                {{ user.prenom ? user.prenom|slice(0,1)|upper : user.email|slice(0,1)|upper }}
            </div>
            <div>
                <h1 style="font-family:'Playfair Display',serif;" class="mb-1">
                    {{ user.prenom and user.nom ? user.prenom ~ ' ' ~ user.nom : user.email }}
                </h1>
                {% if user.ville %}
                <p class="opacity-75 mb-0">
                    <i class="fa-solid fa-map-pin me-1"></i>{{ user.ville }}
                </p>
                {% endif %}
            </div>
            <div class="ms-auto">
                <a href="{{ path('app_profil_edit') }}" class="btn btn-light">
                    <i class="fa-solid fa-pen me-2"></i>Modifier mon profil
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container py-4">
    <div class="row g-4">

        {# Infos profil #}
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">À propos</h5>
                    {% if user.bio %}
                        <p class="text-muted">{{ user.bio }}</p>
                    {% else %}
                        <p class="text-muted fst-italic">Aucune bio renseignée.</p>
                    {% endif %}

                    <hr>

                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex gap-2 align-items-center">
                            <i class="fa-solid fa-envelope" style="color:var(--normand-red);width:20px;"></i>
                            <span class="small">{{ user.email }}</span>
                        </div>
                        {% if user.ville %}
                        <div class="d-flex gap-2 align-items-center">
                            <i class="fa-solid fa-map-pin" style="color:var(--normand-red);width:20px;"></i>
                            <span class="small">{{ user.ville }}</span>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# Stats #}
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Mes contributions</h5>
                    <div class="row g-3 text-center">
                        <div class="col-4">
                            <div class="fw-bold fs-4" style="color:var(--normand-red);">
                                {{ user.lieus|length }}
                            </div>
                            <div class="small text-muted">Lieux</div>
                        </div>
                        <div class="col-4">
                            <div class="fw-bold fs-4" style="color:var(--normand-green);">
                                {{ user.terrains|length }}
                            </div>
                            <div class="small text-muted">Terrains</div>
                        </div>
                        <div class="col-4">
                            <div class="fw-bold fs-4" style="color:#1a237e;">
                                {{ user.avis|length }}
                            </div>
                            <div class="small text-muted">Avis</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Mes lieux #}
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">Mes lieux partagés</h5>
                        <a href="{{ path('app_lieu_new') }}" class="btn btn-normand btn-sm">
                            <i class="fa-solid fa-plus me-1"></i>Ajouter
                        </a>
                    </div>

                    {% if user.lieus|length > 0 %}
                        {% for lieu in user.lieus %}
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <div>
                                <div class="fw-bold">{{ lieu.titre }}</div>
                                <small class="text-muted">
                                    {{ lieu.categorie ? lieu.categorie.nom : '—' }} ·
                                    {{ lieu.createdAt|date('d/m/Y') }}
                                </small>
                            </div>
                            <div class="d-flex gap-2 align-items-center">
                                <span class="badge {{ lieu.estValide ? 'bg-success' : 'bg-warning text-dark' }}">
                                    {{ lieu.estValide ? 'Publié' : 'En attente' }}
                                </span>
                                <a href="{{ path('app_lieu_show', {slug: lieu.slug}) }}"
                                   class="btn btn-sm btn-outline-secondary">Voir</a>
                            </div>
                        </div>
                        {% endfor %}
                    {% else %}
                        <p class="text-muted fst-italic">Vous n'avez pas encore partagé de lieu.</p>
                    {% endif %}
                </div>
            </div>

            {# Mes avis #}
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Mes derniers avis</h5>
                    {% if user.avis|length > 0 %}
                        {% for avis in user.avis|slice(0, 5) %}
                        <div class="py-2 border-bottom">
                            <div class="d-flex justify-content-between">
                                <div class="fw-bold small">
                                    {{ avis.lieu ? avis.lieu.titre : (avis.terrain ? avis.terrain.titre : '—') }}
                                </div>
                                <div class="stars small">
                                    {% for i in 1..5 %}
                                        <i class="fa-{{ i <= avis.note ? 'solid' : 'regular' }} fa-star"></i>
                                    {% endfor %}
                                </div>
                            </div>
                            <p class="text-muted small mb-0">{{ avis.commentaire|slice(0, 80) }}...</p>
                        </div>
                        {% endfor %}
                    {% else %}
                        <p class="text-muted fst-italic">Vous n'avez pas encore laissé d'avis.</p>
                    {% endif %}
                </div>
            </div>
        </div>

    </div>
</div>

{% endblock %}

