{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil — Le Guide Normand{% endblock %}

{% block body %}

<div style="background: linear-gradient(135deg, var(--normand-red), #A52A2A); color: white; padding: 2.5rem 0; position: relative; overflow: hidden;">
    <div class="container">
        <h1 style="font-family:'Playfair Display',serif;">
            <i class="fa-solid fa-pen me-2"></i>Modifier mon profil
        </h1>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-lg-5">

                    {{ form_start(form) }}

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            {{ form_label(form.prenom) }}
                            {{ form_widget(form.prenom) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.nom) }}
                            {{ form_widget(form.nom) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.ville) }}
                        {{ form_widget(form.ville) }}
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.bio) }}
                        {{ form_widget(form.bio) }}
                    </div>

                    <div class="d-flex gap-3 justify-content-end">
                        <a href="{{ path('app_profil_index') }}" class="btn btn-outline-secondary">
                            Annuler
                        </a>
                        <button type="submit" class="btn btn-normand px-5">
                            <i class="fa-solid fa-floppy-disk me-2"></i>Enregistrer
                        </button>
                    </div>

                    {{ form_end(form) }}

                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}